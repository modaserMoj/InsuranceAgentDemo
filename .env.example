# Any ONE of these works. The provider is detected from the key and validated at startup of each
# conversation; a key can also be pasted per-session in the UI. With no key the agent runs offline.
LLM_API_KEY=
# ANTHROPIC_API_KEY=      OPENROUTER_API_KEY=     OPENAI_API_KEY=     GEMINI_API_KEY=
# GROQ_API_KEY=           XAI_API_KEY=            MISTRAL_API_KEY=    DEEPSEEK_API_KEY=    TOGETHER_API_KEY=

# Optional overrides
# LLM_MODEL=                          # otherwise: claude-haiku-5-5 / anthropic/claude-haiku-5.5 / newest small chat model
# LLM_PROVIDER=openai                 # skip detection
# LLM_BASE_URL=https://my-host/v1     # any other OpenAI-compatible endpoint (vLLM, Ollama, Azure proxy...)
LLM_EFFORT=low
# "Today" for appeal-deadline math. The fixtures are from early 2026; leave empty to use the real date.
DEMO_TODAY=2026-03-05
